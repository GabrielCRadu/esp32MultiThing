{
  "manifest_version": 3,
  "name": "ESP32 Media Bridge",
  "version": "1.0",
  "description": "Pushes accurate media position from browser to the ESP32 remote control server.",
  "permissions": ["tabs"],
  "host_permissions": ["http://localhost:8000/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
